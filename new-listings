<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Truck Mandi — Gaadi Listings</title>
<link rel="icon" href="../truckmandi-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#1f2421;--cream:#faf6ef;--gold:#f2a900;--rust:#b8391f;--green:#1f4d3a;--line:#1f2421;--mute:#6b6b66}
*{box-sizing:border-box;margin:0}
body{font:16px/1.45 Inter,system-ui,sans-serif;background:var(--cream);color:var(--ink);padding-bottom:84px}
h1,h2,.brand,.price{font-family:'Barlow Condensed',Impact,sans-serif}
header{position:sticky;top:0;z-index:20;background:var(--ink);border-bottom:5px solid var(--gold);display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px}
.brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:28px;font-weight:700;letter-spacing:.5px;text-decoration:none}
.brand img{width:48px;height:48px;border-radius:10px;background:#fff}
.brand b{color:var(--gold)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:0;border-radius:6px;padding:12px 16px;font:600 16px Inter,sans-serif;color:#fff;background:var(--rust);text-decoration:none;cursor:pointer}
.btn.gold{background:var(--gold);color:var(--ink)}
.btn.green{background:#1a8f4a}
.btn.ghost{background:#fff;color:var(--ink);border:2px solid var(--ink)}
.btn:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.wrap{max-width:720px;margin:0 auto;padding:0 14px}
.intro{padding:22px 0 8px}
h1{font-size:34px;line-height:1.05}
.intro p{color:var(--mute);margin-top:6px}
.how{display:grid;gap:8px;margin:14px 0;background:#fff;border:2px solid var(--line);padding:14px 16px}
.how h2{font-size:22px}
.how ol{padding-left:20px;display:grid;gap:4px}
.filters{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.filters input{grid-column:1/-1}
input,select{width:100%;padding:12px;border:2px solid var(--line);border-radius:6px;background:#fff;font:16px Inter,sans-serif}
.count{color:var(--mute);font-size:14px;margin-bottom:10px}
.card{background:#fff;border:3px solid var(--line);margin-bottom:22px}
.seller{background:var(--gold);padding:10px 14px;font-weight:700;font-size:18px;border-bottom:3px solid var(--line)}
.photo{position:relative;aspect-ratio:3/2;background:#ddd;cursor:pointer;overflow:hidden}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.tag{position:absolute;padding:6px 12px;border-radius:6px;font-weight:600;font-size:14px;color:#fff}
.t-tyre{top:12px;left:12px;background:var(--green)}
.t-ver{top:12px;right:12px;background:#777}
.t-ver.ok{background:#1a8f4a}
.t-ph{bottom:12px;right:12px;background:rgba(0,0,0,.65)}
.body{padding:14px 16px}
.body h3{font-size:24px}
.sub{color:var(--mute);margin-top:2px}
.row{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.price{font-size:34px;font-weight:700;color:var(--green)}
.state{border:2px solid var(--rust);color:var(--rust);padding:4px 12px;border-radius:4px;font-weight:600}
.acts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.empty{text-align:center;padding:40px 10px;color:var(--mute)}
/* support bar */
.bar{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--ink);padding:10px 14px;display:flex;gap:8px;justify-content:center}
.bar .btn{flex:1;max-width:340px}
/* modal */
.modal{position:fixed;inset:0;z-index:40;background:rgba(0,0,0,.6);display:none;overflow:auto;padding:14px}
.modal.on{display:block}
.sheet{max-width:560px;margin:0 auto;background:var(--cream);border:3px solid var(--line);position:relative}
.x{position:absolute;top:10px;right:10px;z-index:3;width:42px;height:42px;border-radius:50%;border:0;background:var(--ink);color:var(--gold);font-size:22px;cursor:pointer}
.gal{position:relative;aspect-ratio:3/2;background:#222}
.gal img{width:100%;height:100%;object-fit:contain}
.nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;border:0;background:rgba(0,0,0,.55);color:#fff;font-size:22px;cursor:pointer}
.nav.l{left:8px}.nav.r{right:8px}
.dots{position:absolute;bottom:8px;left:0;right:0;text-align:center;color:#fff;font-size:13px}
.det{padding:16px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.chips span{border:2px solid #999;padding:6px 12px;background:#fff;font-weight:500}
.desc{margin:6px 0 12px;color:#444;white-space:pre-line}
.vbox{background:#fff1d1;border:2px solid var(--gold);padding:14px;margin:12px 0}
.vbox p{margin-bottom:10px}
.vbox .btn{width:100%;margin-top:8px}
.okbox{background:#e3f5ea;border:2px solid #1a8f4a;padding:12px;margin:12px 0;font-weight:600}
@media(min-width:720px){.acts{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<header>
  <a class="brand" href="./"><img src="../truckmandi-logo.png" alt="Truck Mandi logo">TRUCK <b>MANDI</b></a>
  <a class="btn" id="hdrCall" href="#">📞 <span id="hdrNum"></span></a>
</header>

<main class="wrap">
  <section class="intro">
    <h1>Bikau gaadiyan, seedhe malik se</h1>
    <p>Photo dekhein, rate dekhein, aur owner ko seedha call karein.</p>
  </section>

  <section class="how">
    <h2>Gaadi kaise dekhein</h2>
    <ol>
      <li>Photo par tap karke saari photos dekhein.</li>
      <li>Rate, model aur KM ki detail padhein.</li>
      <li><b>Call Owner</b> dabakar seller se baat karein.</li>
      <li>Pakka karne se pehle <b>Verify</b> karwayein.</li>
    </ol>
  </section>

  <section class="filters">
    <input id="q" type="search" placeholder="Gaadi, brand ya seller ka naam khojein" aria-label="Search">
    <select id="fType" aria-label="Chakka"><option value="">Sabhi chakka</option></select>
    <select id="fState" aria-label="State"><option value="">Sabhi state</option></select>
  </section>

  <div class="count" id="count"></div>
  <section id="list"></section>
</main>

<div class="bar">
  <a class="btn gold" id="barWa" href="#" target="_blank" rel="noopener">💬 WhatsApp Support</a>
  <a class="btn" id="barCall" href="#">📞 Support Call</a>
</div>

<div class="modal" id="modal" role="dialog" aria-modal="true">
  <div class="sheet" id="sheet"></div>
</div>

<script>
/* ====== SETTINGS — sirf yahan badlein ====== */
const SCRIPT_URL = "";                 // Apps Script Web App URL yahan paste karein
const SUPPORT = "7549437078";          // support number (10 digit)
const SELLER_FEE = 199, BUYER_FEE = 999;
/* =========================================== */

const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const digits = s => String(s || "").replace(/\D/g, "").slice(-10);
const wa = (num, text) => `https://wa.me/91${num}?text=${encodeURIComponent(text)}`;

// sheet ke column ke alag-alag naam handle karta hai
const pick = (row, names) => {
  const m = {};
  Object.keys(row).forEach(k => m[k.toLowerCase().replace(/[^a-z0-9]/g, "")] = row[k]);
  for (const n of names) { const v = m[n]; if (v !== undefined && String(v).trim() !== "") return String(v).trim(); }
  return "";
};

function driveImg(u) {
  const m = u.match(/[-\w]{25,}/);
  if (/drive\.google\.com|docs\.google\.com/.test(u) && m) return `https://drive.google.com/thumbnail?id=${m[0]}&sz=w1000`;
  return u;
}

function normalize(r) {
  const photos = pick(r, ["documentlink", "photos", "photolinks", "images"])
    .split(/[\s,]+/).filter(u => /^https?:/.test(u)).map(driveImg);
  const price = parseInt(pick(r, ["askingpriceinr", "askingprice", "price"]).replace(/[^\d]/g, "")) || 0;
  const km = parseInt(pick(r, ["kmdriven", "km"]).replace(/[^\d]/g, "")) || 0;
  const tyre = pick(r, ["vehicletyre", "tyre", "chakka"]).replace(/\D/g, "");
  const brand = pick(r, ["vehiclebrand", "brand"]);
  const type = pick(r, ["vehicletype", "type"]);
  const phone = digits(pick(r, ["whatsappno", "phone", "mobile", "contactnumber"]));
  return {
    id: r.id,
    seller: pick(r, ["fullname", "contactname", "name"]) || "Seller",
    phone, photos, price, km, tyre,
    title: [brand, type].filter(Boolean).join(" ") || "Commercial Vehicle",
    year: pick(r, ["modelyear", "year"]),
    state: cleanState(pick(r, ["statecity", "state", "city"])),
    body: pick(r, ["bodytype"]),
    permit: pick(r, ["permittype", "permit"]),
    owners: pick(r, ["ownercount", "owners"]),
    insurance: pick(r, ["insurancevalidity"]),
    fitness: pick(r, ["fitnessvalidity"]),
    desc: pick(r, ["vehicledescription", "description"]),
    verified: /^(yes|y|true|verified)$/i.test(pick(r, ["verified"]))
  };
}

const STATES = [
  ["Bihar", /bihar|patna|\bara\b|buxar|dehri|dumraon|gaya|gopalganj|madhepura|begusarai|muzaffarpur|samastipur|siwan|sonpur|barbigha/i],
  ["Uttar Pradesh", /uttar|\bu\.? ?p\b|utaar|agra|azamgarh|ballia|basti|bijnor|ganjdundwara|ghaziabad|ghazipur|gorakhpur|greater noida|hardoi|jhansi|kanpur|kaushambi|lucknow|meerut|saharanpur|shahjahanpur|sonbhadra|unnao|varanasi|ambedkar|dostpur/i],
  ["Jharkhand", /jharkhand|jamshedpur|dhanbad|ranchi|bokaro|chatra/i],
  ["Chhattisgarh", /chh?attisgarh|\bcg\b|raipur|bhilai|bemetara|ambikpur|ambikapur|mahasamund|jagdalpur/i],
  ["Madhya Pradesh", /madhya|\bmp\b|jabalpur|bhopal|rewa|satna|guna|bhind|balaghat/i],
  ["Odisha", /odisha|cuttack|sambalpur|nabarangpur|padampur/i],
  ["West Bengal", /west bengal|kolkata|asansol|siliguri/i],
  ["Karnataka", /karn?atak|bangalore|mysore/i],
  ["Maharashtra", /maharashtra|bhiwandi|khed|latur/i],
  ["Punjab", /punjab|ludhiana/i],
  ["Uttarakhand", /haldwani|kashipur/i],
  ["Haryana", /bhiwani|yamuna nagar/i],
  ["Rajasthan", /alwar|nasirabad/i],
  ["Delhi", /delhi/i],
  ["Himachal Pradesh", /himachal|solan/i]
];
const cleanState = s => { for (const [n, re] of STATES) if (re.test(s)) return n; return s; };

const inr = n => "₹" + Number(n).toLocaleString("en-IN");
const fmtKm = n => Number(n).toLocaleString("en-IN") + " km";
let ALL = [], VIEW = [];

function card(v, i) {
  const img = v.photos[0] ? `<img src="${esc(v.photos[0])}" alt="${esc(v.title)}" loading="lazy" referrerpolicy="no-referrer">` : "";
  return `<article class="card">
    <div class="seller">👤 ${esc(v.seller)}</div>
    <div class="photo" data-open="${i}">${img}
      ${v.tyre ? `<span class="tag t-tyre">${esc(v.tyre)} Chakka</span>` : ""}
      <span class="tag t-ver ${v.verified ? "ok" : ""}">${v.verified ? "✔ Verified" : "Unverified"}</span>
      ${v.photos.length ? `<span class="tag t-ph">${v.photos.length} photos</span>` : ""}
    </div>
    <div class="body">
      <h3>${esc(v.title)}</h3>
      <div class="sub">${[v.year, v.km ? fmtKm(v.km) : ""].filter(Boolean).join(" • ")}</div>
      <div class="row"><span class="price">${v.price ? inr(v.price) : "Rate puchhein"}</span>${v.state ? `<span class="state">${esc(v.state)}</span>` : ""}</div>
      <div class="acts">
        <a class="btn" href="tel:+91${v.phone}">📞 Call Owner</a>
        <button class="btn ghost" data-open="${i}">Details</button>
      </div>
    </div>
  </article>`;
}

function render() {
  const q = $("#q").value.toLowerCase(), t = $("#fType").value, s = $("#fState").value;
  VIEW = ALL.filter(v =>
    (!t || v.tyre === t) && (!s || v.state === s) &&
    (!q || (v.title + v.seller + v.state + v.body).toLowerCase().includes(q)));
  $("#count").textContent = `${VIEW.length} gaadiyan mili`;
  $("#list").innerHTML = VIEW.length ? VIEW.map(card).join("") :
    `<div class="empty">Koi gaadi nahi mili. Filter badal kar dekhein.</div>`;
}

function fillFilters() {
  const uniq = k => [...new Set(ALL.map(v => v[k]).filter(Boolean))].sort();
  uniq("tyre").forEach(x => $("#fType").add(new Option(x + " Chakka", x)));
  uniq("state").forEach(x => $("#fState").add(new Option(x, x)));
}

let gi = 0, gv = null;
function openModal(i) {
  gv = VIEW[i]; gi = 0;
  const v = gv;
  const vmsg = who => `Namaste Truck Mandi, mujhe ${who} verification karwana hai.\nGaadi: ${v.title} ${v.year}\nSeller: ${v.seller}\nListing no: ${v.id}`;
  const chips = [v.body || "", v.tyre ? v.tyre + " Chakka" : "", v.year, v.km ? fmtKm(v.km) : "",
    v.owners ? v.owners + " Owner" : "", v.permit, v.insurance ? "Insurance: " + v.insurance : "", v.fitness ? "Fitness: " + v.fitness : ""]
    .filter(Boolean).map(c => `<span>${esc(c)}</span>`).join("");
  $("#sheet").innerHTML = `
    <button class="x" aria-label="Band karein" data-close>✕</button>
    <div class="gal"><img id="gimg" alt="" referrerpolicy="no-referrer">
      ${v.photos.length > 1 ? `<button class="nav l" data-nav="-1" aria-label="Pichhli photo">‹</button><button class="nav r" data-nav="1" aria-label="Agli photo">›</button>` : ""}
      <div class="dots" id="gdots"></div></div>
    <div class="det">
      <div class="seller" style="display:inline-block;border:0">👤 ${esc(v.seller)}</div>
      <h2 style="font-size:34px;margin-top:8px">${esc(v.title)}</h2>
      <div class="price">${v.price ? inr(v.price) : "Rate puchhein"}</div>
      <div class="chips">${chips}</div>
      ${v.desc ? `<p class="desc">${esc(v.desc)}</p>` : ""}
      ${v.verified ? `<div class="okbox">✔ Yeh gaadi Truck Mandi se verified hai.</div>` : `
      <div class="vbox">
        <p><b>Yeh listing abhi Unverified hai.</b> Verify karayein to gaadi zyada buyers tak pahunchegi aur jaldi bikegi.</p>
        <a class="btn gold" target="_blank" rel="noopener" href="${wa(SUPPORT, vmsg("Seller"))}">✔ Seller ho? Verify Now — ${inr(SELLER_FEE)}</a>
        <a class="btn ghost" target="_blank" rel="noopener" href="${wa(SUPPORT, vmsg("Buyer"))}">🛡 Buyer ho? Verify Now — ${inr(BUYER_FEE)}</a>
      </div>`}
      <a class="btn" style="width:100%" href="tel:+91${v.phone}">📞 Call Owner</a>
    </div>`;
  showPhoto();
  $("#modal").classList.add("on");
  document.body.style.overflow = "hidden";
}
function showPhoto() {
  const p = gv.photos;
  $("#gimg").src = p.length ? p[gi] : "../truckmandi-logo.png";
  $("#gdots").textContent = p.length > 1 ? `${gi + 1} / ${p.length}` : "";
}
function closeModal() { $("#modal").classList.remove("on"); document.body.style.overflow = ""; }

document.addEventListener("click", e => {
  const o = e.target.closest("[data-open]"); if (o) return openModal(+o.dataset.open);
  const n = e.target.closest("[data-nav]");
  if (n) { const L = gv.photos.length; gi = (gi + +n.dataset.nav + L) % L; return showPhoto(); }
  if (e.target.closest("[data-close]") || e.target.id === "modal") closeModal();
});
document.addEventListener("keydown", e => e.key === "Escape" && closeModal());
["#q", "#fType", "#fState"].forEach(s => $(s).addEventListener("input", render));

// support links
const pretty = SUPPORT.replace(/(\d{5})(\d{5})/, "$1 $2");
$("#hdrNum").textContent = pretty;
$("#hdrCall").href = $("#barCall").href = "tel:+91" + SUPPORT;
$("#barWa").href = wa(SUPPORT, "Namaste Truck Mandi, mujhe madad chahiye.");

const DEMO = [
  {id: 2, "Full Name": "Pragyan", "Whatsapp No": SUPPORT, "State/City": "Bihar", "Vehicle Brand": "Tata", "Vehicle Type": "Truck", "Model Year": "2012", "Vehicle Tyre": "6", "KM Driven": "410000", "Asking Price (INR)": "650000", "Owner Count": "1", "Permit Type": "National Permit"},
  {id: 3, "Full Name": "Lucky Kesharwani", "Whatsapp No": SUPPORT, "State/City": "Cg", "Vehicle Brand": "Tata", "Vehicle Type": "Truck", "Model Year": "2017", "Vehicle Tyre": "6", "KM Driven": "100000", "Asking Price (INR)": "600000"}
];

(async () => {
  try {
    // SCRIPT_URL ho to live sheet se, nahi to listings.json (file) se
    let rows;
    try { rows = await (await fetch(SCRIPT_URL || "listings.json")).json(); }
    catch (e) { if (SCRIPT_URL) throw e; rows = DEMO; }
    ALL = rows.map(normalize).filter(v => v.phone);
    fillFilters(); render();
  } catch (err) {
    $("#list").innerHTML = `<div class="empty">Listings load nahi hui. Internet check karke page dobara kholein.</div>`;
  }
})();
</script>
</body>
</html>
